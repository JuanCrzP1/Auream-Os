{
  "name": "bots-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS conversacional multi-tenant",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix apps/web run build",
    "dev": "scripts/dev/start.sh",
    "dev:web": "npm --prefix apps/web run dev",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:web": "npm --prefix apps/web run check",
    "test": "vitest run",
    "test:web": "npm --prefix apps/web run test",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:test": "node scripts/db/migrate.mjs",
    "db:migrate:prod": "node scripts/db/migrate.mjs --confirm-production",
    "db:seed:test": "node scripts/db/seed-dev.mjs",
    "db:import-automations:test": "npm run build && node --env-file=.env.test dist/apps/api/scripts/importJsonAutomations.js",
    "db:import-automations:prod": "npm run build && node --env-file=.env dist/apps/api/scripts/importJsonAutomations.js --confirm-production"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tesseract.js-data/spa": "1.0.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "2.2.13",
    "pg": "^8.23.0",
    "sharp": "^0.34.4",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
