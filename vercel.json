{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix apps/web ci",
  "buildCommand": "node scripts/vercel/build.mjs",
  "outputDirectory": "apps/web/dist",
  "regions": ["cle1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/tesseract.js/**,node_modules/tesseract.js-core/index.js,node_modules/tesseract.js-core/package.json,node_modules/tesseract.js-core/*lstm*,node_modules/@tesseract.js-data/spa/package.json,node_modules/@tesseract.js-data/spa/4.0.0_best_int/**}"
    },
    "api/task-alarm.ts": {
      "maxDuration": 30,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "auream-task-alarms", "retryAfterSeconds": 30 }]
    }
  },
  "crons": [
    { "path": "/api/internal/tasks/run", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/.well-known/(oauth-.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
