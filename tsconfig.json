{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "api/**/*.ts",
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "domains/**/*.ts",
    "flow-engine/**/*.ts",
    "platform/**/*.ts",
    "infrastructure/**/*.ts",
    "contracts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "apps/web"
  ]
}
