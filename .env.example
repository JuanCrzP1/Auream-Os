# ---------------------------------------------------------------------------
# Variables de entorno — bots-ai-platform
#
# Copia este archivo a .env y completa los valores. .env está ignorado por
# git; este archivo (.env.example) no lleva ningún valor real.
# ---------------------------------------------------------------------------

# --- Backend (apps/api) ---------------------------------------------------

# Los tokens de usuario los emite y firma Neon Auth: esta API no firma ninguno
# y no necesita un secreto propio.

# Obligatoria en producción (NODE_ENV=production). Orígenes permitidos para
# CORS, separados por comas. En desarrollo cae a http://localhost:5173 y
# http://127.0.0.1:5173 si se deja vacía.
CORS_ALLOWED_ORIGINS=

# Opcional. Puerto de la API. Por defecto 3100.
PORT=

# Opcional, solo desarrollo. API key de desarrollo; debe empezar por "bfk_".
# La API se niega a arrancar si esta variable está definida con
# NODE_ENV=production.
DEV_API_KEY=

# Opcional, solo desarrollo. Tenant asociado a DEV_API_KEY. Por defecto
# "test-tenant".
DEV_TENANT_ID=

# Opcional. Directorio de persistencia JSON (solo desarrollo local). Por
# defecto ./data/builder-workspaces.
DATA_DIR=

# Opcional. Dónde se guardan las automatizaciones: "sql" (PostgreSQL) o "json"
# (archivos en DATA_DIR). Por defecto "json" en desarrollo; en producción solo
# se acepta "sql" (si se omite, es "sql").
AUTOMATIONS_STORE=

# Opcional. Zona horaria IANA con la que se ejecutan los flujos (reglas de día,
# hora y fecha del Condicional) mientras las cuentas no tengan la suya. Por
# defecto America/Bogota.
DEFAULT_TENANT_TIMEZONE=

# Opcional, SOLO desarrollo. "true" deja que el bloque Integración llame a
# servicios de la red privada (localhost, LAN) para probar contra un servicio
# local. Por defecto las integraciones solo llegan a Internet público
# (protección SSRF). La API no arranca si se activa en producción.
INTEGRATIONS_ALLOW_PRIVATE_NETWORK=

# Clave maestra con la que se cifran las claves de IA de los clientes
# (AES-256-GCM). Base64 de 32 bytes: openssl rand -base64 32
# OBLIGATORIA en producción. Guárdala en el gestor de secretos: si se pierde,
# las conexiones de IA guardadas no se pueden leer y hay que volver a pegarlas.
CREDENTIALS_ENCRYPTION_KEY=
# Opcional, para rotar: versión de la clave actual (por defecto v1) y las
# anteriores que aún deben poder leerse, "v1:base64,v0:base64".
BLOB_READ_WRITE_TOKEN=
# ↑ Archivos de los mensajes en Vercel Blob. En Vercel lo pone el propio
#   almacén al conectarlo (no se copia a mano). Vacío en desarrollo: la API
#   guarda en data/media y los sirve en /media/local/files/…
# Dirección pública de la API para las URLs de esos archivos locales
# (por defecto http://localhost:<PORT>).
PUBLIC_API_BASE_URL=

# Opcional. Versión de la Graph API de Meta para el bloque Pixel (API de
# Conversiones). Por defecto v23.0. Meta mantiene cada versión unos dos años.
META_GRAPH_API_VERSION=

CREDENTIALS_ENCRYPTION_KEY_VERSION=
CREDENTIALS_ENCRYPTION_OLD_KEYS=

# Estándar de Node. "development" o "production".
NODE_ENV=

# --- Base de datos (Neon / PostgreSQL) --------------------------------------
#
# Producción vive en Vercel + Neon: ver docs/operations/deploy-vercel-neon.md.
# Allí estas variables se configuran en el panel de Vercel, no en un archivo.

# Opcional. Conexiones máximas del pool por proceso (por defecto 10; en
# Vercel, 3 por instancia de función).
DATABASE_POOL_MAX=

# Connection string de Postgres de la rama de ESTE entorno. Obtenla con
# `npx neonctl connection-string <rama> --pooled` (nombre posicional: el flag
# --branch-id se ignora silenciosamente y devuelve la rama por defecto).
DATABASE_URL=

# Proveedor de identidad (Neon Auth) de ESTE entorno.
NEON_AUTH_URL=

# Emisor exigido en los JWT. OBLIGATORIO: las ramas de Neon comparten la misma
# clave de firma, así que sin validar el emisor un token de otra rama sería
# aceptado. Es el host del endpoint de auth de esta rama.
NEON_AUTH_ISSUER=

# Audiencia exigida. Si se omite se usa NEON_AUTH_ISSUER.
NEON_AUTH_AUDIENCE=

# Endpoint del JWKS. Si se omite se deriva de NEON_AUTH_URL.
NEON_AUTH_JWKS_URL=

# --- Frontend (apps/web) ---------------------------------------------------

# Obligatoria en builds de producción. URL base de la API. En desarrollo cae
# a http://localhost:3100 si se deja vacía.
VITE_API_BASE_URL=

# Opcional, solo desarrollo. Debe coincidir con DEV_API_KEY. Sólo se lee
# cuando el build es de desarrollo (import.meta.env.DEV); nunca se compila
# en un build de producción.
VITE_DEV_API_KEY=

# Obligatoria. URL del proveedor de identidad para el navegador.
VITE_NEON_AUTH_URL=

# Opcional. WhatsApp por código QR con uazapi (https://uazapi.com): la
# dirección de TU servidor de uazapi y su token de administrador (panel de
# uazapi). Sin ellas, las conexiones por QR se crean pero no se vinculan.
# Necesita CREDENTIALS_ENCRYPTION_KEY: el token de cada número se guarda cifrado.
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=

# Opcional. Dirección pública de esta API (con /api) donde uazapi avisa si un
# número se conecta o desconecta. En Vercel producción se deduce sola
# (https://<dominio oficial>/api). En local no hace falta: la pantalla consulta.
WHATSAPP_WEBHOOK_BASE_URL=

# Cola de tareas (Programador, «Tiempo agotado», pausas largas). Ver
# docs/architecture/task-queue.md.
#
# Obligatoria en producción. Llave del trabajador de la cola: protege
# /api/internal/tasks/run (Vercel Cron la envía sola como «Authorization:
# Bearer …»). Mínimo 16 caracteres; generar: openssl rand -hex 32
# Sin ella, la cola solo corre dentro del proceso (servidor local).
CRON_SECRET=

# Opcional. Duración de una ronda del trabajador, en ms (por defecto 50000;
# debe quedar por debajo del maxDuration de la función).
TASK_RUNNER_BUDGET_MS=

# Opcional. Dirección pública de la API (con /api) para que la cola se
# despierte a sí misma cuando algo vence en segundos. En Vercel producción
# se deduce sola.
TASKS_BASE_URL=

# Opcional. Despertadores con Vercel Queues («on» u «off»): cada tarea que
# vence en minutos, horas o días suena a su hora con un mensaje con retraso, sin
# cron frecuente ni funciones esperando. Por defecto «on» en Vercel con
# CRON_SECRET y «off» en local (allí la cola corre en el proceso).
TASK_ALARMS=

# Opcional. Cadena de rondas (sin despertadores ni cron cada minuto): mientras
# algo venza dentro de este margen (ms), cada ronda despierta a la siguiente.
# Por defecto 0 con despertadores y 900000 (15 min) sin ellos. Mientras corre,
# la función se mantiene activa: más margen = más consumo del plan.
TASK_CHAIN_HORIZON_MS=
