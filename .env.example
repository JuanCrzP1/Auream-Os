# ---------------------------------------------------------------------------
# Variables de entorno — bots-ai-platform
#
# Copia este archivo a .env y completa los valores. .env está ignorado por
# git; este archivo (.env.example) no lleva ningún valor real.
# ---------------------------------------------------------------------------

# --- Backend (apps/api) ---------------------------------------------------

# Los tokens de usuario los emite y firma Neon Auth: esta API no firma ninguno
# y no necesita un secreto propio.

# Obligatoria en producción (NODE_ENV=production). Orígenes permitidos para
# CORS, separados por comas. En desarrollo cae a http://localhost:5173 y
# http://127.0.0.1:5173 si se deja vacía.
CORS_ALLOWED_ORIGINS=

# Opcional. Puerto de la API. Por defecto 3100.
PORT=

# Opcional, solo desarrollo. API key de desarrollo; debe empezar por "bfk_".
# La API se niega a arrancar si esta variable está definida con
# NODE_ENV=production.
DEV_API_KEY=

# Opcional, solo desarrollo. Tenant asociado a DEV_API_KEY. Por defecto
# "test-tenant".
DEV_TENANT_ID=

# Opcional. Directorio de persistencia JSON (solo desarrollo local). Por
# defecto ./data/builder-workspaces.
DATA_DIR=

# Estándar de Node. "development" o "production".
NODE_ENV=

# --- Base de datos (Neon / PostgreSQL) --------------------------------------

# Connection string de Postgres de la rama de ESTE entorno. Obtenla con
# `npx neonctl connection-string <rama> --pooled` (nombre posicional: el flag
# --branch-id se ignora silenciosamente y devuelve la rama por defecto).
DATABASE_URL=

# Proveedor de identidad (Neon Auth) de ESTE entorno.
NEON_AUTH_URL=

# Emisor exigido en los JWT. OBLIGATORIO: las ramas de Neon comparten la misma
# clave de firma, así que sin validar el emisor un token de otra rama sería
# aceptado. Es el host del endpoint de auth de esta rama.
NEON_AUTH_ISSUER=

# Audiencia exigida. Si se omite se usa NEON_AUTH_ISSUER.
NEON_AUTH_AUDIENCE=

# Endpoint del JWKS. Si se omite se deriva de NEON_AUTH_URL.
NEON_AUTH_JWKS_URL=

# --- Frontend (apps/web) ---------------------------------------------------

# Obligatoria en builds de producción. URL base de la API. En desarrollo cae
# a http://localhost:3100 si se deja vacía.
VITE_API_BASE_URL=

# Opcional, solo desarrollo. Debe coincidir con DEV_API_KEY. Sólo se lee
# cuando el build es de desarrollo (import.meta.env.DEV); nunca se compila
# en un build de producción.
VITE_DEV_API_KEY=

# Obligatoria. URL del proveedor de identidad para el navegador.
VITE_NEON_AUTH_URL=
