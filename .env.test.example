# ---------------------------------------------------------------------------
# Variables de los TESTS DE INTEGRACIÓN — bots-ai-platform
#
# Copia a .env.test y completa. Nombres distintos de los de producción a
# propósito: los tests nunca hacen fallback a DATABASE_URL.
#
# Los scripts comprueban además el HOST real de la conexión: aunque estas
# variables apunten por error a producción, la ejecución se aborta.
# ---------------------------------------------------------------------------

# Postgres de la rama `test`.
#   npx neonctl connection-string test --project-id <id> --pooled
TEST_DATABASE_URL=

# Neon Auth de la rama `test`.
TEST_NEON_AUTH_URL=
TEST_NEON_AUTH_ISSUER=
TEST_NEON_AUTH_AUDIENCE=
